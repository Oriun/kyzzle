{
  "name": "kyzzle",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./data_types": {
      "types": "./dist/data_types/pg_types.d.cts",
      "require": {
        "types": "./dist/data_types/pg_types.d.cts",
        "default": "./dist/data_types/pg_types.cjs"
      },
      "import": {
        "types": "./dist/data_types/pg_types.d.mts",
        "default": "./dist/data_types/pg_types.mjs"
      }
    },
    "./definition": {
      "types": "./dist/definition.d.cts",
      "require": {
        "types": "./dist/definition.d.cts",
        "default": "./dist/definition.cjs"
      },
      "import": {
        "types": "./dist/definition.d.mts",
        "default": "./dist/definition.mjs"
      }
    },
    "./types": {
      "types": "./dist/types.d.cts",
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      },
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "pnpm install && pnpm build:test",
    "test": "tsx --test --watch tests/*.test.ts",
    "test:ci": "tsx --test tests/*.test.ts",
    "prepare": "tsdown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "kysely": "^0.28.8",
    "pg": "^8.16.3",
    "tsdown": "^0.18.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "kyzzle_test": "file:./"
  }
}
